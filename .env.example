ENVIRONMENT=production
LOG_LEVEL=INFO

# Production PostgreSQL. For local development you may use sqlite+aiosqlite:///./scanner.db
DATABASE_URL=postgresql+asyncpg://scanner:scanner_password@postgres:5432/scanner

COINBASE_REST_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
COINBASE_WS_PRODUCT_CHUNK_SIZE=80
COINBASE_WS_MAX_MESSAGE_SIZE_BYTES=67108864
ENABLE_LEVEL2=true
ENABLE_CANDLES_CHANNEL=true
BOOTSTRAP_HISTORY_DAYS=365
ANALYSIS_HISTORY_DAYS=31
BOOTSTRAP_CONCURRENCY=1

QUOTE_FRESH_IDEAL_SECONDS=2
QUOTE_FRESH_WARNING_SECONDS=10
ALERT_MAX_QUOTE_AGE_SECONDS=10
SCAN_INTERVAL_SECONDS=10
CANDIDATE_LIMIT=5
MIN_EARLY_MOVE_SCORE=78
MIN_RISK_ADJUSTED_OPPORTUNITY_SCORE=78
MIN_MICROCAP_RISK_ADJUSTED_OPPORTUNITY_SCORE=88
MIN_MICROCAP_EARLY_MOVE_SCORE=82
MIN_MICROCAP_LIQUIDITY_SAFETY_SCORE=55
MIN_MICROCAP_VOLUME_ACCELERATION_SCORE=45
MIN_CATALYST_OVERRIDE_SCORE=85
SUPPRESS_EXTENDED_24H_PCT=20

MARKET_CAP_LARGE_THRESHOLD_USD=1000000000
MARKET_CAP_MID_THRESHOLD_USD=250000000
MARKET_CAP_SMALL_THRESHOLD_USD=50000000
MICROCAP_THRESHOLD_USD=50000000
MICROCAP_REFRESH_SECONDS=600
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

CATALYST_POLL_SECONDS=60
CATALYST_FRESH_WINDOW_MINUTES=360
# Optional comma-separated official project/blog/announcement URLs to monitor in addition to exchange sources.
CATALYST_SOURCE_URLS=

DISCORD_ALERT_WEBHOOK_URL=
DISCORD_CATALYST_WEBHOOK_URL=
DISCORD_DEBUG_WEBHOOK_URL=
DISCORD_HEARTBEAT_SECONDS=3600
DISCORD_HEARTBEAT_ALLOW_PRIMARY=false

API_HOST=0.0.0.0
API_PORT=8000
